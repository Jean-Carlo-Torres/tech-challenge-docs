            },
            "nrqlQueries": [
              {
                "accountIds": [
                  8666376
                ],
                "query": "\r\nFROM Log SELECT count(*) AS 'OS criadas'\r\nWHERE event = 'service_order.created' AND environment = 'prod'\r\nSINCE 30 days ago TIMESERIES 1 day\r\n"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "thresholds": {
