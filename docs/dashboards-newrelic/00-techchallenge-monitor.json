{
  "name": "TechChallenge-monitor",
  "description": null,
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "TechChallenge-monitor",
      "description": null,
      "widgets": [
        {
          "title": "Logs da API chegando, com os campos esperados",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "chartStyles": {
              "lineInterpolation": "linear"
            },
            "facet": {
              "showOtherSeries": false
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  8666376
                ],
                "query": "FROM Log SELECT count(*) WHERE service = 'techchallenge-api' SINCE 30 minutes ago FACET event"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Um log completo, para conferir os nomes dos atributos (correlationId, durationMs...)",
          "layout": {
            "column": 5,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "logger.log-table-widget"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8666376
                ],
                "query": "FROM Log SELECT * WHERE event = 'http.request' LIMIT 1"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "APM da API (depende do parâmetro /techchallenge/prod/newrelic/license-key no SSM)",
          "layout": {
            "column": 9,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "chartStyles": {
              "lineInterpolation": "linear"
            },
            "facet": {
              "showOtherSeries": false
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  8666376
                ],
                "query": "FROM Transaction SELECT count(*) WHERE appName = 'techchallenge-api-prod' SINCE 30 minutes ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Métricas do cluster (nri-bundle)",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  8666376
                ],
                "query": "\r\nFROM K8sNodeSample SELECT count(*) WHERE clusterName = 'techchallenge-prod' SINCE 30 minutes ago FACET nodeName"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        }
