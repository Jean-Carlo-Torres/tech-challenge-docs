{
  "name": "Erros e falhas nas integrações",
  "description": null,
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Erros e falhas nas integrações",
      "description": null,
      "widgets": [
        {
          "title": "-- Falhas de autenticação e de cliente (4xx) por rota",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 7,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  8666376
                ],
                "query": "-- Falhas de autenticação e de cliente (4xx) por rota\r\nFROM Log SELECT count(*)\r\nWHERE event = 'http.request' AND environment = 'prod' AND statusCode >= 400 AND statusCode < 500\r\nFACET route, statusCode SINCE 24 hours ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Taxa de erro 5xx (sem as probes)",
          "layout": {
            "column": 8,
            "row": 1,
            "width": 5,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "chartStyles": {
              "lineInterpolation": "linear",
              "lineWidths": {
                "lineWidth": 2.25
              }
            },
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "markers": {
              "displayedTypes": {
                "annotations": true,
                "criticalViolations": false,
                "deployments": true,
                "relatedDeployments": true,
                "warningViolations": false
              }
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  8666376
                ],
                "query": "-- Taxa de erro 5xx (sem as probes)\r\nFROM Log SELECT percentage(count(*), WHERE statusCode >= 500) AS 'Erros 5xx (%)'\r\nWHERE event = 'http.request' AND environment = 'prod'\r\nAND route NOT IN ('/api/health', '/api/health/ready')\r\nSINCE 24 hours ago TIMESERIES 30 minutes\r\n"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "thresholds": {
              "isLabelVisible": true
            },
            "yAxisLeft": {
              "zero": true
            },
            "yAxisRight": {
              "zero": true
            }
          }
        },
        {
          "title": "Erros 5xx por rota e tipo de exceção",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "chartStyles": {
              "lineInterpolation": "linear",
              "lineWidths": {
                "lineWidth": 2.25
              }
            },
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "markers": {
              "displayedTypes": {
                "annotations": true,
                "criticalViolations": false,
                "deployments": true,
                "relatedDeployments": true,
                "warningViolations": false
              }
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  8666376
                ],
                "query": "-- Erros 5xx por rota e tipo de exceção\r\nFROM Log SELECT count(*)\r\nWHERE event = 'http.error' AND environment = 'prod'\r\nFACET route, errorName SINCE 24 hours ago TIMESERIES 30 minutes"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "thresholds": {
              "isLabelVisible": true
            },
            "yAxisLeft": {
              "zero": true
            },
            "yAxisRight": {
              "zero": true
            }
          }
        },
        {
          "title": "Últimos erros, com o ID para seguir a requisição (ver seção 3)",
          "layout": {
            "column": 5,
            "row": 4,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "logger.log-table-widget"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8666376
                ],
                "query": "-- Últimos erros, com o ID para seguir a requisição (ver seção 3)\r\nFROM Log SELECT timestamp, route, statusCode, errorName, correlationId\r\nWHERE event = 'http.error' AND environment = 'prod'\r\nSINCE 24 hours ago LIMIT 20\r\n"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        }
      ]
    }
  ],
  "variables": []
}