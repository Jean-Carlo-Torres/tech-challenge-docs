  "pages": [
    {
      "name": "Latência das APIs",
      "description": null,
      "widgets": [
        {
          "title": "APM: média e p95 em ms",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 12,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "chartStyles": {
              "lineInterpolation": "linear",
              "lineWidths": {
                "lineWidth": 2.25
              }
            },
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "markers": {
              "displayedTypes": {
                "annotations": true,
                "criticalViolations": false,
                "deployments": true,
                "relatedDeployments": true,
                "warningViolations": false
              }
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  8666376
                ],
                "query": "-- APM: média e p95 em ms\r\nFROM Transaction SELECT average(duration) * 1000 AS 'Média (ms)', percentile(duration, 95) * 1000 AS 'p95 (ms)'\r\nWHERE appName = 'techchallenge-api-prod'\r\nSINCE 3 hours ago TIMESERIES\r\n"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "thresholds": {
              "isLabelVisible": true
            },
            "yAxisLeft": {
              "zero": true
            },
            "yAxisRight": {
              "zero": true
            }
          }
        },
        {
          "title": "Por rota, pelos logs (durationMs já vem em ms)",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 12,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.stacked-bar"
          },
          "rawConfiguration": {
            "chartStyles": {
              "gradient": {
                "enabled": false
              },
              "seriesOrder": "original",
              "stacked": {
                "enabled": true
              }
            },
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "markers": {
              "displayedTypes": {
                "annotations": true,
                "criticalViolations": false,
                "deployments": true,
                "relatedDeployments": true,
                "warningViolations": false
              }
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  8666376
                ],
                "query": "-- Por rota, pelos logs (durationMs já vem em ms)\r\nFROM Log SELECT average(durationMs) AS 'Média (ms)', percentile(durationMs, 95) AS 'p95 (ms)', count(*) AS 'Requisições'\r\nWHERE event = 'http.request' AND environment = 'prod'\r\nAND route NOT IN ('/api/health', '/api/health/ready')\r\nFACET route SINCE 3 hours ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "thresholds": {
              "isLabelVisible": true
            }
          }
        }
      ]
    }
  ],
  "variables": []
