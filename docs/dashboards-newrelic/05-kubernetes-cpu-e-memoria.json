                  8666376
                ],
                "query": "-- Réplicas disponíveis da API\r\nFROM K8sDeploymentSample SELECT latest(podsAvailable) AS 'Disponíveis', latest(podsDesired) AS 'Desejadas'\r\nWHERE clusterName = 'techchallenge-prod' AND namespaceName = 'techchallenge' AND deploymentName = 'techchallenge'\r\nSINCE 3 hours ago TIMESERIES"
