      "widgets": [
        {
          "title": "PU por pod da API (milicores)",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.stacked-bar"
          },
          "rawConfiguration": {
            "chartStyles": {
              "gradient": {
                "enabled": false
              },
              "seriesOrder": "original",
              "stacked": {
                "enabled": true
              }
            },
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "markers": {
              "displayedTypes": {
                "annotations": true,
                "criticalViolations": false,
                "deployments": true,
                "relatedDeployments": true,
                "warningViolations": false
              }
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  8666376
                ],
                "query": "-- CPU por pod da API (milicores)\r\nFROM K8sContainerSample SELECT average(cpuUsedCores) * 1000 AS 'mCPU'\r\nWHERE clusterName = 'techchallenge-prod' AND namespaceName = 'techchallenge' AND containerName = 'api'\r\nFACET podName SINCE 3 hours ago TIMESERIES\r\n"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "thresholds": {
              "isLabelVisible": true
            }
          }
        },
        {
          "title": "Memória por pod da API (MiB) e uso do limite de 512Mi",
          "layout": {
            "column": 5,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.stacked-bar"
          },
          "rawConfiguration": {
            "chartStyles": {
              "gradient": {
                "enabled": false
              },
              "seriesOrder": "original",
              "stacked": {
                "enabled": true
              }
            },
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "markers": {
              "displayedTypes": {
                "annotations": true,
                "criticalViolations": false,
                "deployments": true,
                "relatedDeployments": true,
                "warningViolations": false
              }
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  8666376
                ],
                "query": "-- Memória por pod da API (MiB) e uso do limite de 512Mi\r\nFROM K8sContainerSample SELECT max(memoryWorkingSetBytes) / 1048576 AS 'MiB',\r\nmax(memoryWorkingSetBytes) / max(memoryLimitBytes) * 100 AS '% do limite'\r\nWHERE clusterName = 'techchallenge-prod' AND namespaceName = 'techchallenge' AND containerName = 'api'\r\nFACET podName SINCE 3 hours ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "thresholds": {
              "isLabelVisible": true
            }
          }
        },
        {
          "title": "Pods Pending (falta de CPU/memória nos nós)",
          "layout": {
            "column": 9,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "chartStyles": {
              "lineInterpolation": "linear",
              "lineWidths": {
                "lineWidth": 2.25
