                "relatedDeployments": true,
                "warningViolations": false
              }
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  8666376
                ],
                "query": "-- Pods Pending (falta de CPU/memória nos nós)\r\nFROM K8sPodSample SELECT uniqueCount(podName) AS 'Pods Pending'\r\nWHERE clusterName = 'techchallenge-prod' AND status = 'Pending'\r\nSINCE 3 hours ago TIMESERIES\r\n"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "thresholds": {
              "isLabelVisible": true
            },
            "yAxisLeft": {
              "zero": true
            },
            "yAxisRight": {
              "zero": true
            }
          }
        },
        {
          "title": "Folga dos nós (os 2 t3.medium são o gargalo do cluster)",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 12,
            "height": 4
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "chartStyles": {
              "lineInterpolation": "linear",
              "lineWidths": {
