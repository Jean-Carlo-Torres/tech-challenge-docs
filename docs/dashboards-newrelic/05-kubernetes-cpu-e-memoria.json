            "markers": {
              "displayedTypes": {
                "annotations": true,
                "criticalViolations": false,
                "deployments": true,
                "relatedDeployments": true,
                "warningViolations": false
              }
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  8666376
                ],
                "query": "-- Folga dos nós (os 2 t3.medium são o gargalo do cluster)\r\nFROM K8sNodeSample SELECT average(cpuUsedCores) / average(allocatableCpuCores) * 100 AS 'CPU (%)',\r\naverage(memoryWorkingSetBytes) / average(allocatableMemoryBytes) * 100 AS 'Memória (%)'\r\nWHERE clusterName = 'techchallenge-prod'\r\nFACET nodeName SINCE 3 hours ago TIMESERIES"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "thresholds": {
              "isLabelVisible": true
            },
            "yAxisLeft": {
